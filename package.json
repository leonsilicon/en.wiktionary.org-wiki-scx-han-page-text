{
  "name": "en.wiktionary.org-wiki-scx-han-page-text",
  "version": "0.20260501.0",
  "description": "Wiktionary page text for every Han-script character (Script_Extensions=Han), extracted from the English Wiktionary dump and exposed via per-character dynamic imports.",
  "homepage": "https://github.com/leonsilicon/en.wiktionary.org-wiki-scx-han-page-text#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/en.wiktionary.org-wiki-scx-han-page-text/issues"
  },
  "license": "MIT",
  "author": "Leon Silicon <leon@leonsilicon.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/en.wiktionary.org-wiki-scx-han-page-text.git"
  },
  "keywords": [
    "wiktionary",
    "han",
    "cjk",
    "chinese",
    "unicode",
    "script-extensions",
    "dictionary",
    "wikitext"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "unicode"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./unicode/*.json": "./unicode/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "parse": "node --experimental-strip-types scripts/parse.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "desm": "^1.3.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
